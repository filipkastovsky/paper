{
  "name": "@paper/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noCheck && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "NODE_OPTIONS=\"--import tsx\" drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "NODE_OPTIONS=\"--import tsx\" drizzle-kit studio",
    "openapi:dump": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^9.0.4",
    "@fastify/otel": "^0.8.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@paper/shared": "workspace:*",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-metrics": "^12.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
